# quanly.store — mẫu biến môi trường. KHÔNG chứa secret thật.
# Copy thành .env.local khi dev local. Không bao giờ commit file .env* chứa secret.
# Secret thật chỉ đặt qua Cloudflare (wrangler secret put) theo môi trường.

# --- API (Workers) ---
# D1 database id — điền sau khi tạo D1 trên Cloudflare (wrangler d1 create quanly-store-db)
D1_DATABASE_ID=b61411fd-1dbd-4ff0-80f0-c442ac48d683
# R2 bucket — điền sau khi tạo bucket trên Cloudflare
R2_BUCKET_NAME=quanly-store-files
# Session: khóa ký token (tạo ngẫu nhiên, giữ riêng từng môi trường, KHÔNG commit)
SESSION_SECRET=
# OTP — Kalvin chốt 10/11/2026: dùng EMAIL OTP, miễn phí (Resend free tier:
# 3.000 email/tháng, tối đa 100/ngày — tham chiếu, chưa tạo key thật).
# OTP_SENDER=email (kênh chính, cho đăng nhập chủ tiệm / nhân viên).
OTP_SENDER=email
# OTP_DEV_MODE: chỉ true ở dev local. Production LUÔN false.
# Dev mode bật thì OTP chỉ hiện trong log dev, không gửi thật.
OTP_DEV_MODE=false
# Resend — CHỈ placeholder, KHÔNG key thật ở đây. Key thật đặt bằng:
#   wrangler secret put RESEND_API_KEY
RESEND_API_KEY=
EMAIL_FROM=quanly.store <no-reply@quanly.store>
# SMS OTP: giữ dạng stub trong abstraction để cắm provider sau, không làm thật.
# Khách đặt lịch online trong MVP: giữ SĐT làm định danh, chưa gửi OTP SMS.
# SMS_PROVIDER=

# --- Web app ---
# URL API, vd http://localhost:8787 khi dev local, https://api.<domain> khi deploy
VITE_API_URL=http://localhost:8787
